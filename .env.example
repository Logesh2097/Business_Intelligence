# BI Assistant settings. Copy to .env (which is not in git) and change what you need.
# Every key is explained in docs/design/architecture.md §7.
#
# THIS FILE HOLDS NO REAL SECRET. Every value that begins with "change-me" is a
# placeholder: it works on your own machine, and the app refuses to start with it
# outside development. Real values go in .env locally and in Secret Manager in the cloud.

# dev | test | staging | prod. Outside dev and test, unsafe values below are refused at start.
BI_ENV=dev
BI_PORT=8110

# PostgreSQL. Three users with three jobs (docs/design/data-model.md §2).
# These three passwords are what `docker compose` gives the local database when it is
# first created. The three DSNs below must carry the same passwords.
BI_PG_OWNER_PASSWORD=change-me-owner
BI_PG_APP_PASSWORD=change-me-app
BI_PG_READONLY_PASSWORD=change-me-readonly

# bi_app: the API's own reads and writes.
BI_PG_DSN=postgresql://bi_app:change-me-app@localhost:5610/bi
# bi_readonly: used only to run AI-written SQL. Must be a different user from bi_app.
BI_PG_READONLY_DSN=postgresql://bi_readonly:change-me-readonly@localhost:5610/bi
# bi_owner: migrations and the seed only. Never set this for the running API outside dev and test.
BI_PG_OWNER_DSN=postgresql://bi_owner:change-me-owner@localhost:5610/bi

# PostgreSQL connection pool. The same sizes apply to the app pool and the read-only pool.
# MIN=0 holds no connection until one is needed, so the API starts even if the database is down.
BI_PG_POOL_MIN=0
BI_PG_POOL_MAX=10
# Seconds to wait when opening a connection, and when waiting for a free one from the pool.
BI_PG_CONNECT_TIMEOUT_SECONDS=3
BI_PG_POOL_TIMEOUT_SECONDS=5
# Seconds before the database cancels one of the API's own statements.
# (AI-written SQL has its own, shorter limit: BI_QUERY_TIMEOUT_SECONDS below.)
BI_PG_STATEMENT_TIMEOUT_SECONDS=30

# MongoDB: conversations, reports, document records.
# If your server needs a password, put it in the URL here: mongodb://user:password@host:port
BI_MONGO_URL=mongodb://localhost:27027
BI_MONGO_DB=bi
# Milliseconds to wait for the server before giving up, and the most connections to keep.
BI_MONGO_TIMEOUT_MS=2000
BI_MONGO_POOL_MAX=20

# Qdrant: document and example search.
BI_QDRANT_URL=http://localhost:6343
BI_QDRANT_API_KEY=

# OpenAI. Without a key and a model name the question API answers 503 "not set up".
# BI_LLM_MODEL writes the SQL; BI_LLM_MODEL_FAST writes the short explanation
# (leave it empty to use the main model for both). Use model names your account has.
BI_OPENAI_API_KEY=
# Leave empty for OpenAI. To use another service that speaks OpenAI's API, put its
# address here and that service's key and model names in the variables around it.
# Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Outside development it must be an https address.
BI_OPENAI_BASE_URL=
BI_LLM_MODEL=
BI_LLM_MODEL_FAST=
# Turns document text into vectors for document search. The service at
# BI_OPENAI_BASE_URL must offer /embeddings for this model. Changing it after documents
# were indexed needs the index rebuilt (the vector size differs).
BI_EMBEDDING_MODEL=text-embedding-3-small

# Signs access tokens and context tokens. At least 32 characters: openssl rand -hex 32
# Left empty in development, a random key is made at each start (sessions end at restart).
# Outside development an empty key is refused.
BI_SECRET_KEY=
BI_ACCESS_TOKEN_MINUTES=15
BI_REFRESH_TOKEN_DAYS=14

# How the agents reach the tools: direct (in process) or mcp. direct until Phase 8.
BI_TOOLS_TRANSPORT=direct
BI_MCP_URL=http://localhost:8111/mcp
# Where the MCP process (python -m app.mcp_server) listens. Keep it off the internet.
# With BI_TOOLS_TRANSPORT=mcp, the API and the MCP process must share BI_SECRET_KEY:
# set it explicitly, because the random development key differs between processes.
BI_MCP_HOST=127.0.0.1
BI_MCP_PORT=8111

# Uploaded documents: a local folder, or a Cloud Storage bucket in the cloud.
BI_UPLOAD_DIR=./data/uploads
BI_GCS_BUCKET=
# One uploaded document may be this large (MB); a company may hold this many.
BI_DOC_MAX_MB=20
BI_DOC_MAX_PER_TENANT=200
# Passages scoring below this (0 to 1) are not used to answer. A starting value.
BI_RAG_MIN_SCORE=0.30

# Demo data. Refused outside dev and test.
BI_SEED_DEMO=true
BI_SEED_PASSWORD=change-me-demo
# Pin "today" as YYYY-MM-DD for tests and the golden question set. Refused outside dev and test.
BI_FAKE_TODAY=

# Limits (docs/design/security.md §8).
BI_DAILY_QUESTION_LIMIT=500
BI_DAILY_TOKEN_LIMIT=2000000
BI_QUERY_TIMEOUT_SECONDS=15
BI_QUERY_MAX_ROWS=1000
# The longest one agent answer may take from start to end (model calls and the query).
# After it the agent answers with status "timeout".
BI_AGENT_TIMEOUT_SECONDS=90
# The longest one assistant answer may take: the supervisor, every agent it chose and
# the combined summary. After it the answer has status "timeout" and whatever finished.
BI_ASSISTANT_TIMEOUT_SECONDS=150
